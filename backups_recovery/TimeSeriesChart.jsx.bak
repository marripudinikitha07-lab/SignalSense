import React, { useMemo } from 'react';
import {
  ResponsiveContainer,
  ComposedChart,
  Line,
  Scatter,
  XAxis,
  YAxis,
  Tooltip,
  Legend,
  CartesianGrid,
  ReferenceDot,
} from 'recharts';
import { AlertCircle, Sliders, Eye } from 'lucide-react';
import { useAnalysis } from '../contexts/AnalysisContext';
import { useTheme } from '../contexts/ThemeContext';

export default function TimeSeriesChart() {
  const { results, selectedPointIndex, setSelectedPointIndex, selectedFeature, timeRange, setTimeRange } = useAnalysis();
  const { theme } = useTheme();

  const isDark = theme === 'dark';

  // Format data for chart display
  const chartData = useMemo(() => {
    if (!results || !results.timestamps || !results.feature_values) return [];

    const total = results.timestamps.length;
    const start = Math.max(0, Math.min(timeRange[0], total - 10));
    const end = Math.min(total, Math.max(start + 10, timeRange[1]));

    const slice = [];
    for (let i = start; i < end; i++) {
      const isAnomaly = results.predictions ? results.predictions[i] === 1 : false;
      const val = results.feature_values[i];
      slice.push({
        index: i,
        timestamp: results.timestamps[i] || `t_${i}`,
        value: val,
        // For scatter marker on anomalies
        anomalyValue: isAnomaly ? val : null,
        isAnomaly: isAnomaly,
        combinedScore: results.combined_scores ? results.combined_scores[i] : null,
      });
    }
    return slice;
  }, [results, timeRange]);

  if (!results) {
    return (
      <div className="w-full h-80 rounded-2xl bg-cream-50/50 dark:bg-plum-950/40 border border-plum-900/10 dark:border-coral-300/15 flex flex-col items-center justify-center text-center p-6">
        <Eye className="w-10 h-10 text-berry-600 dark:text-coral-300 mb-3" />
        <h3 className="font-heading font-bold text-plum-900 dark:text-cream-200 text-base">
          Time-Series Chart Awaiting Data
        </h3>
        <p className="text-xs text-plum-700/80 dark:text-cream-300/70 max-w-md mt-1">
          Click <strong>&ldquo;Run Anomaly Detection&rdquo;</strong> to execute the LFTSAD model and render real observed measurements, detected anomalies, and discrepancies.
        </p>
      </div>
    );
  }

  const selectedPoint =
    selectedPointIndex !== null && results.feature_values && selectedPointIndex < results.feature_values.length
      ? {
          index: selectedPointIndex,
          val: results.feature_values[selectedPointIndex],
        }
      : null;

  const totalPoints = results.timestamps ? results.timestamps.length : 0;

  // Custom Dot renderer for anomalies
  const renderAnomalyDot = (props) => {
    const { cx, cy, payload } = props;
    if (!payload.isAnomaly || cx === undefined || cy === undefined) return null;

    const isSelected = payload.index === selectedPointIndex;

    return (
      <g
        key={`anomaly-marker-${payload.index}`}
        className="cursor-pointer"
        onClick={() => setSelectedPointIndex(payload.index)}
      >
        <circle
          cx={cx}
          cy={cy}
          r={isSelected ? 7 : 5}
          fill="#E11D48"
          stroke={isSelected ? '#FFEBB8' : '#FFFFFF'}
          strokeWidth={isSelected ? 2.5 : 1.5}
        />
        {isSelected && (
          <circle
            cx={cx}
            cy={cy}
            r={11}
            fill="none"
            stroke="#BD5579"
            strokeWidth={1.5}
            strokeDasharray="2 2"
          />
        )}
      </g>
    );
  };

  return (
    <div className="card-theme rounded-2xl p-5 shadow-sm space-y-4">
      {/* Chart Top Controls */}
      <div className="flex flex-wrap items-center justify-between gap-3 pb-2 border-b border-plum-900/10 dark:border-coral-300/10">
        <div>
          <div className="flex items-center space-x-2">
            <h2 className="font-heading font-bold text-sm sm:text-base text-plum-900 dark:text-cream-200">
              {selectedFeature} Multivariate Observation Stream
            </h2>
            <span className="font-mono text-xs px-2 py-0.5 rounded-full bg-berry-600/15 text-berry-700 dark:text-coral-300 font-semibold">
              {results.total_anomalies || 0} Anomalies Detected
            </span>
          </div>
          <p className="text-xs text-plum-700/80 dark:text-coral-200/70 mt-0.5">
            Click on any <span className="text-red-500 font-bold">red marker</span> to inspect its point-level & sequence-level reconstruction discrepancies.
          </p>
        </div>

        {/* Window Range Control */}
        {totalPoints > 100 && (
          <div className="flex items-center space-x-2 text-xs">
            <span className="text-plum-800 dark:text-cream-300 font-medium">Window:</span>
            <select
              value={`${timeRange[0]}-${timeRange[1]}`}
              onChange={(e) => {
                const [s, en] = e.target.value.split('-').map(Number);
                setTimeRange([s, en]);
              }}
              className="px-2.5 py-1 rounded-lg border border-plum-900/15 dark:border-coral-300/20 bg-cream-100 dark:bg-plum-900/70 text-plum-900 dark:text-cream-200 font-mono text-xs focus:outline-hidden"
            >
              <option value="0-200">Range: 0 – 200</option>
              <option value="200-400">Range: 200 – 400</option>
              <option value="400-800">Range: 400 – 800</option>
              <option value="800-1500">Range: 800 – 1500</option>
              <option value={`0-${totalPoints}`}>Full Stream (0 – {totalPoints})</option>
            </select>
          </div>
        )}
      </div>

      {/* Main Interactive Time-Series Graph */}
      <div className="w-full h-80 sm:h-96">
        <ResponsiveContainer width="100%" height="100%">
          <ComposedChart
            data={chartData}
            margin={{ top: 15, right: 25, bottom: 20, left: 10 }}
            onClick={(state) => {
              if (state && state.activePayload && state.activePayload.length > 0) {
                const idx = state.activePayload[0].payload.index;
                setSelectedPointIndex(idx);
              }
            }}
          >
            <CartesianGrid
              strokeDasharray="3 3"
              stroke={isDark ? 'rgba(234, 157, 157, 0.1)' : 'rgba(96, 29, 73, 0.08)'}
            />
            <XAxis
              dataKey="index"
              tickLine={false}
              stroke={isDark ? '#EA9D9D' : '#601D49'}
              tick={{ fill: isDark ? '#FFEBB8' : '#601D49', fontSize: 11, fontFamily: 'JetBrains Mono' }}
              label={{
                value: 'Observation Sequence Index (t)',
                position: 'insideBottom',
                offset: -10,
                fill: isDark ? '#FFEBB8' : '#601D49',
                fontSize: 12,
                fontWeight: 600,
              }}
            />
            <YAxis
              tickLine={false}
              stroke={isDark ? '#EA9D9D' : '#601D49'}
              tick={{ fill: isDark ? '#FFEBB8' : '#601D49', fontSize: 11, fontFamily: 'JetBrains Mono' }}
              domain={['auto', 'auto']}
              label={{
                value: `${selectedFeature} (Normalized Magnitude)`,
                angle: -90,
                position: 'insideLeft',
                offset: 5,
                fill: isDark ? '#FFEBB8' : '#601D49',
                fontSize: 12,
                fontWeight: 600,
              }}
            />
            <Tooltip
              content={({ active, payload }) => {
                if (!active || !payload || !payload.length) return null;
                const d = payload[0].payload;
                return (
                  <div className="p-3 rounded-xl bg-plum-950/95 text-[#FFEBB8] border border-berry-700/50 shadow-xl backdrop-blur-md text-xs font-mono space-y-1">
                    <div className="flex items-center justify-between border-b border-berry-700/40 pb-1 mb-1">
                      <span className="font-bold text-white">Observation #{d.index}</span>
                      {d.isAnomaly ? (
                        <span className="px-1.5 py-0.5 rounded bg-red-600/80 text-white font-bold text-[10px]">
                          ANOMALY
                        </span>
                      ) : (
                        <span className="px-1.5 py-0.5 rounded bg-emerald-600/60 text-white font-bold text-[10px]">
                          NORMAL
                        </span>
                      )}
                    </div>
                    <div>Value: <span className="text-white font-bold">{Number(d.value).toFixed(4)}</span></div>
                    {d.combinedScore !== null && (
                      <div>Combined Discrepancy: <span className="text-[#EA9D9D] font-bold">{Number(d.combinedScore).toFixed(6)}</span></div>
                    )}
                    <div className="text-[10px] text-cream-200/70 pt-1">
                      Click observation to load 4 score cards below
                    </div>
                  </div>
                );
              }}
            />
            <Legend
              verticalAlign="top"
              align="right"
              wrapperStyle={{ paddingBottom: '8px', fontSize: '12px' }}
            />

            {/* Normal Continuous Line */}
            <Line
              type="monotone"
              dataKey="value"
              name={`Measurement (${selectedFeature})`}
              stroke={isDark ? '#EA9D9D' : '#601D49'}
              strokeWidth={2}
              dot={false}
              activeDot={{ r: 5, stroke: '#BD5579', strokeWidth: 2, fill: '#FFEBB8' }}
            />

            {/* Scatter Layer for Detected Anomalies */}
            <Scatter
              dataKey="anomalyValue"
              name="Detected Anomalies"
              shape={renderAnomalyDot}
            />

            {/* Highlighted Reference Dot for Currently Selected Point */}
            {selectedPoint && selectedPoint.index >= timeRange[0] && selectedPoint.index <= timeRange[1] && (
              <ReferenceDot
                x={selectedPoint.index}
                y={selectedPoint.val}
                r={9}
                fill="#BD5579"
                stroke="#FFEBB8"
                strokeWidth={2}
              />
            )}
          </ComposedChart>
        </ResponsiveContainer>
      </div>

      {/* Legend & interaction helper */}
      <div className="flex flex-wrap items-center justify-between gap-4 pt-2 text-xs text-plum-800/80 dark:text-cream-200/80 border-t border-plum-900/10 dark:border-coral-300/10">
        <div className="flex items-center space-x-4">
          <span className="flex items-center space-x-1.5">
            <span className="w-3 h-0.5 bg-plum-700 dark:bg-coral-300 rounded"></span>
            <span>Signal Measurement</span>
          </span>
          <span className="flex items-center space-x-1.5">
            <span className="w-2.5 h-2.5 rounded-full bg-red-600 border border-white"></span>
            <span>Detected Anomaly (Exceeds Threshold)</span>
          </span>
          <span className="flex items-center space-x-1.5">
            <span className="w-3 h-3 rounded-full bg-berry-600 border border-cream-200"></span>
            <span>Currently Selected Observation</span>
          </span>
        </div>
        <div className="font-mono text-[11px] text-berry-700 dark:text-coral-300">
          Showing {chartData.length} of {totalPoints} timesteps
        </div>
      </div>
    </div>
  );
}
